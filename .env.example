QUEUE_METRICS_INTERVAL_MS=15000
READ_RATE_LIMIT_PER_MINUTE=120
API_KEY_CACHE_TTL_MS=60000
ALERT_ENCRYPTION_KEY=
RETENTION_INTERVAL_MS=3600000
AUDIT_LOG_RETENTION_DAYS=365
ALERT_DELIVERY_RETENTION_DAYS=90
INCIDENT_EVENT_RETENTION_DAYS=180
