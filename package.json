{
  "name": "logmind-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:api-logger-express && npm run build:frontend-logger && npm run build:api && npm run build:worker && npm run build:agent && npm run build:dashboard && npm run build:demo",
    "build:api-logger-express": "tsc -p packages/api-logger-express/tsconfig.app.json",
    "build:frontend-logger": "tsc -p packages/frontend-logger/tsconfig.app.json",
    "build:api": "tsc -p apps/api/tsconfig.app.json",
    "build:worker": "tsc -p apps/worker/tsconfig.app.json",
    "build:agent": "tsc -p apps/agent/tsconfig.app.json",
    "build:dashboard": "npm run build -w apps/dashboard",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:agent": "tsx watch apps/agent/src/main.ts",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "start:agent": "node dist/apps/agent/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && npm run lint -w apps/dashboard",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p apps/api/tsconfig.app.json --noEmit && tsc -p apps/worker/tsconfig.app.json --noEmit && tsc -p apps/agent/tsconfig.app.json --noEmit && tsc -p apps/demo-services/tsconfig.app.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "docker:up": "docker compose up -d postgres mongodb redis",
    "docker:down": "docker compose down",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prepare": "husky",
    "build:demo": "tsc -p apps/demo-services/tsconfig.app.json",
    "start:demo": "node dist/apps/demo-services/src/main.js",
    "dev:demo": "tsx watch apps/demo-services/src/main.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^7.9.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dockerode": "^4.0.0",
    "express": "^5.2.1",
    "ioredis": "^5.0.0",
    "mongoose": "^8.0.0",
    "pino": "^9.0.0",
    "prisma": "^6.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testcontainers/mongodb": "^12.0.4",
    "@testcontainers/postgresql": "^12.0.4",
    "@testcontainers/redis": "^12.0.4",
    "@types/dockerode": "^3.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
